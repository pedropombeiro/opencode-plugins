#!/usr/bin/env bash
#MISE description="Build all plugins, or only the packages passed as arguments"
set -euo pipefail
if [ $# -gt 0 ]; then
  pkgs=()
  for name in "$@"; do
    if [ ! -d "packages/$name" ]; then
      echo "Package not found: packages/$name" >&2
      exit 1
    fi
    pkgs+=("packages/$name/")
  done
else
  pkgs=(packages/*/)
fi
for pkg in "${pkgs[@]}"; do
  pkg=${pkg%/}
  echo "Building $(basename "$pkg")..."
  for entry in index tui; do
    [ -f "$pkg/src/$entry.ts" ] || continue
    bun build "$pkg/src/$entry.ts" --outdir "$pkg/dist" --target bun \
      --external '@opencode/plugin' --external '@opencode/plugin/*'
  done
done
