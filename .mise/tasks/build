#!/usr/bin/env bash
#MISE description="Build all plugins, or only the packages passed as arguments"
#MISE raw_args=true
#USAGE arg "[package]" var=#true help="Packages to build (default: all)"
#USAGE complete "package" run="find packages -mindepth 2 -maxdepth 2 -name package.json | sed 's|/package.json$||; s|^packages/||'"
set -euo pipefail
if [ $# -gt 0 ]; then
  pkgs=()
  for name in "$@"; do
    if [ ! -d "packages/$name" ]; then
      echo "Package not found: packages/$name" >&2
      exit 1
    fi
    pkgs+=("packages/$name/")
  done
else
  pkgs=(packages/*/)
fi
for pkg in "${pkgs[@]}"; do
  pkg=${pkg%/}
  echo "Building $(basename "$pkg")..."
  bun .mise/bundle.ts "$pkg" "$pkg/dist"
done
