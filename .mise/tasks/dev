#!/usr/bin/env bash
#MISE description="Build with sourcemaps for development"
#USAGE arg "<package>" help="Package to build (e.g. terminal-progress)"
set -euo pipefail
pkg="packages/${usage_package}"
if [ ! -d "$pkg" ]; then
  echo "Package not found: $pkg" >&2
  exit 1
fi
for entry in index tui; do
  [ -f "$pkg/src/$entry.ts" ] || continue
  bun build "$pkg/src/$entry.ts" --outdir "$pkg/dist" --target bun --sourcemap=inline \
    --external '@opencode/plugin' --external '@opencode/plugin/*'
done
