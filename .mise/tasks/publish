#!/usr/bin/env bash
#MISE description="Publish a package to npm"
#USAGE arg "<package>" help="Package to publish (e.g. terminal-progress)"
#USAGE arg "[tag]" help="npm dist-tag" default="latest"
#USAGE complete "package" run="find packages -mindepth 2 -maxdepth 2 -name package.json | sed 's|/package.json$||; s|^packages/||'"
#USAGE complete "tag" type="none"
set -euo pipefail
# shellcheck disable=SC2154 # mise sets usage_* from the #USAGE lines
pkg="packages/${usage_package}"
if [ ! -d "$pkg" ]; then
  echo "Package not found: $pkg" >&2
  exit 1
fi
cd "$pkg"
npm publish --access public --tag "${usage_tag:-latest}"
