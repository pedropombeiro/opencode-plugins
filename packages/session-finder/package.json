{
  "name": "opencode-session-finder",
  "version": "1.2.0",
  "description": "Search previous OpenCode sessions from the desktop or terminal command palette, or ask the agent to search",
  "author": {
    "name": "Pedro Pombeiro",
    "email": "pedropombeiro@users.noreply.github.com"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "default": "./dist/index.js"
    },
    "./tui": {
      "default": "./dist/tui.js"
    },
    "./gui-experimental": {
      "default": "./dist/gui-experimental.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedropombeiro/opencode-plugins.git",
    "directory": "packages/session-finder"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "session",
    "search",
    "history"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@opencode/plugin": "^2.3.0",
    "@opentui/core": ">=0.7.0",
    "@opentui/solid": ">=0.7.0",
    "solid-js": ">=1.9.0"
  }
}
