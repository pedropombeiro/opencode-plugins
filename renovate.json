{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergePatch",
    ":automergeRequireAllStatusChecks",
    ":separateMajorReleases",
    ":prImmediately"
  ],
  "separateMinorPatch": true,
  "packageRules": [
    {
      "description": "Group GitHub Actions updates weekly",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "schedule": ["before 9am on sunday"],
      "pinDigests": true
    },
    {
      "description": "Group pre-commit hook updates",
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hooks"
    },
    {
      "description": "Automerge patch, pin, and digest updates, and mark them in PR titles",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true,
      "automergeStrategy": "rebase",
      "commitMessageSuffix": "- `AUTOMERGE`"
    },
    {
      "description": "Update OpenTUI packages together, so only one @opentui/core version is installed",
      "matchPackageNames": ["@opentui/{/,}**"],
      "groupName": "opentui"
    },
    {
      "description": "Hold TypeScript below 7 until typescript-eslint supports it (TS 7.0 ships no compiler API)",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "Hold Vite below 8 until @opencode/plugin's gui() stops setting the deprecated inlineDynamicImports option",
      "matchPackageNames": ["vite"],
      "allowedVersions": "<8"
    }
  ]
}
